# TMDB API Configuration
# v4 için ACCESS_TOKEN kullanın (önerilen)
VITE_TMDB_ACCESS_TOKEN=your_access_token_here

# v3 fallback için API_KEY (geçiş sürecinde)
VITE_TMDB_API_KEY=your_api_key_here

# Base URL (v4 için otomatik olarak 4 olarak ayarlanır)
VITE_TMDB_BASE_URL=https://api.themoviedb.org/4

# Image Base URL
VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Language
VITE_TMDB_LANGUAGE=tr-TR